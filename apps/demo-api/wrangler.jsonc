{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmd-demo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "f04aaf2faa3d0eef049f6fdbc0af0c37",
  "routes": [
    {
      "pattern": "mmd-api.zyking.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
    "CORS_ORIGIN": "https://mmd.zyking.xyz"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a936d2b3c5c84bed9afb6e0ada7194f6"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "20260715",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 19 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
