{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmd-demo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "routes": [
    {
      "pattern": "mmd-api.zyking.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
    "CORS_ORIGIN": "https://mmd.zyking.xyz"
  },
  "observability": {
    "enabled": true
  }
}
